		"name": "Finekra.TenantAccount",
		"description": "Finekra Banka Hesabı Ekleme, Silme, Düzenleme methodlarının olduğu collection'dır.\n\nLogin methoduyla başarılı şekilde accessToken alındıktan sonra, Collection'da variables'a eklenir.\n\nSonrasında diğer methodlar kullanılabilir.\n\nİsteklerde 401 hatası alınırsa, tekrardan login methoduyla yeni token alınıp işlemlere devam edilebilir.\n\nMethod'larda kullanılacak olan BankId bilgisini Bankalar isteğinden dönen liste'de banka bilgilerinde Id değeri kullanılacaktır.\n\nAynı Durum CurrencyId içinde geçerli olup, currencyId için Para Birimleri isteğini kullanabilirsiniz.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "31063131"
	},
	"item": [
		{
			"name": "Banka Hesabı Ekleme",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"iban\": \"TR090006262423238952687395\",//nullable\r\n    \"balance\": 1000.0, // Bakiye\r\n    \"branchCode\": \"1021\",// hesap şube bilgisi nullable \r\n    \"branchName\": \"Merkez Şube\",// hesap şube bilgisi nullable \r\n    \"accountNumber\": \"52687395\",//nullable \r\n    \"accountSuffix\": \"\",//hesap ek no - nullable \r\n    \"currencyId\": 1, // Para Birimi id'si ,Para Birimleri servisinden alabilirsiniz. not null\r\n    \"description\": \"Deneme hesap açıklaması\", //nullable \r\n    \"name\": \"Vadesiz TL Hesabı\",//nullable \r\n    \"type\": 0, // 0: Vadesiz, 1: Kredi, 2: Vadeli //nullable \r\n    \"dueDate\": \"2025-09-11T00:00:00Z\", // Vade Bitiş Tarihi - nullable\r\n    \"interestRate\": \"15%\", // Vade Faiz Oranı- nullable\r\n    \"isCalculated\": true, // Hesaplamalara dahil edilsin mi? -not null\r\n    \"bankId\": 10, //Bankalar Servisinden alabilirsiniz. -not null\r\n    \"creditLimit\": 10000.0,//Kredili Hesap ise Total Kredi Limiti - nullable\r\n    \"lastQueryDate\": \"2025-09-16T10:04:00Z\",//İlgili Bakiye bilgisinin hangi tarih saatte bankadan alındığıdır. - nullable\r\n    \"availableCreditLimit\": 8000.0,//Kredili hesap ise kullanılabilir kredi limitidir\r\n    \"availableCreditBalance\": 7500.0, // bakiyeden, bloke tutar düşülmüş, müşterinin esas kullanabildiği meblag - nullable\r\n    \"availableBalance\": 5000.0,//kullanılabilir bakiye + kmh kullanımı varsa kmhda kullanabilir olduğu meblag - nullable\r\n    \"openDate\": \"2020-01-01T00:00:00Z\",//hesap açılış tarihi - nullable\r\n    \"creditBalance\": 2000.0,//Kredi Bakiyesidir --nullable\r\n    \"blockedAmount\": 0.0//Blokedeki tutardır. - nullable\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},

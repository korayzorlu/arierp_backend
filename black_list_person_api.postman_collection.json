{
  "info": {
    "name": "Black List API",
    "description": "Arınet'te kayıtlı yasaklı kişi listesini dış sistemlere sunan endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Black List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/compliance/black_list_persons/?ac={{ac}}",
          "host": ["{{base_url}}"],
          "path": ["api", "compliance", "black_list_persons", ""],
          "query": [
            {
              "key": "ac",
              "value": "{{ac}}",
              "description": "Zorunlu. Arı Leasing şirket UUID'si"
            }
          ]
        },
        "description": "Şirkete ait yasaklı kişi kayıtlarının tamamını tek seferde liste olarak döner.\n\n**ZORUNLU PARAMETRE:**\n- ac (UUID) — Arı Leasing şirket UUID'si\n\n**PARAMETRELER:**\n- uuid (string) — Kaydın benzersiz kimliği\n- name (string) — İsim / unvan\n- tc_vkn_passport_no (string) — TC / VKN / pasaport numarası\n- other_names (string) — Bilinen diğer isimler\n- nationality (string) — Uyruk\n- birthday (string) — Doğum tarihi\n- organization (string) — Örgüt\n- date_number (string) — Resmi Gazete tarih ve sayısı"
      },
      "response": [
        {
          "name": "Başarılı",
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "[\n  {\n    \"uuid\": \"11111111-1111-1111-1111-111111111111\",\n    \"name\": \"Örnek Kişi\",\n    \"tc_vkn_passport_no\": \"00000000000\",\n    \"other_names\": \"Örnek Takma Ad\",\n    \"nationality\": \"Örnek Uyruk\",\n    \"birthday\": \"01.01.1980\",\n    \"organization\": \"Örnek Örgüt\",\n    \"date_number\": \"01.01.2020 - 00000\"\n  }\n]"
        },
        {
          "name": "Hata - İstek Limiti (429)",
          "status": "Too Many Requests",
          "code": 429,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"detail\": \"Request was throttled. Expected available in 1 second.\"\n}"
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://arinet.arileasing.com.tr",
      "description": "API'nin çalıştığı sunucunun base URL'i"
    },
    {
      "key": "ac",
      "value": "00000000-0000-0000-0000-000000000000",
      "description": "Arı Leasing şirket UUID'si"
    }
  ]
}
